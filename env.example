# AI API Configuration -- works with OpenRouter, NordRouter, or any OpenAI-compatible
# chat-completions endpoint. API_BASE_URL defaults to OpenRouter if left blank.
OPENAI_API_KEY=your_api_key_here
API_BASE_URL=https://openrouter.ai/api/v1

# Telegram lesson-start/end notifications (same bot as math/physics tutors, see
# ../math-tutor-agent/scripts/lesson-watch-config.json for the token already in use)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Server Configuration
PORT=3000
NODE_ENV=development

# Rate Limiting (optional - defaults will be used if not set)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security (optional)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# API Configuration (optional)
API_TIMEOUT=30000
MAX_MESSAGE_LENGTH=1000
MAX_RETRIES=3

# Logging (optional)
LOG_LEVEL=info
LOG_TO_FILE=false 

